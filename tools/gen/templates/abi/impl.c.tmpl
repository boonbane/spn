#include "sp.h"
#include "spn.h"
#include "external/wasm/abi.h"

{{ for .fns }}
static {{ .ret_type }} spn_abi_thunk_{{ .short }}(wasm_exec_env_t env{{ for .args }}, {{ .ctype }} a{{ .i }}{{ end }}) {
  spn_wasm_ctx_t abi = spn_wasm_ctx(env);
{{ for .args }}
{{ if .str }}
  const c8* s{{ .i }} = SP_NULLPTR;
  if (!spn_wasm_read_str(&abi, a{{ .i }}, &s{{ .i }})) {
    {{ .fail }}
  }
{{ end }}
{{ if .required }}
  if (!s{{ .i }}) {
    {{ .null }}
  }
{{ end }}
{{ if .out }}
  u32 o{{ .i }} = 0;
  if (!wasm_runtime_validate_native_addr(abi.instance, a{{ .i }}, sizeof(o{{ .i }}))) {
    {{ .fail }}
  }
{{ end }}
{{ if .handle }}
  void* h{{ .i }} = SP_NULLPTR;
{{ if .r_err }}
  spn_try(spn_wasm_resolve_handle(abi.handles, a{{ .i }}, {{ .kind }}, &h{{ .i }}));
{{ else }}
  if (spn_wasm_resolve_handle(abi.handles, a{{ .i }}, {{ .kind }}, &h{{ .i }})) {
    return 0;
  }
{{ end }}
{{ end }}
{{ end }}
{{ if .r_err }}
  spn_try({{ .host }}({{ .call }}));
{{ for .args }}
{{ if .out }}
  sp_mem_copy(a{{ .i }}, &o{{ .i }}, sizeof(o{{ .i }}));
{{ end }}
{{ end }}
  return SPN_OK;
{{ end }}
{{ if .r_str }}
  return spn_wasm_copy_str(&abi, {{ .host }}({{ .call }}));
{{ end }}
{{ if .r_handle }}
  void* result = (void*)({{ .host }}({{ .call }}));
  if (!result) return 0;
  return spn_wasm_add_handle(abi.handles, result, {{ .ret_kind }});
{{ end }}
}

{{ end }}
bool spn_wasm_register_api(void) {
  static NativeSymbol natives [] = {
{{ for .fns }}
    { "{{ .name }}", spn_abi_thunk_{{ .short }}, "{{ .sig }}", SP_NULLPTR },
{{ end }}
  };
  return wasm_runtime_register_natives("env", natives, sp_carr_len(natives));
}
