+static bool sp_msvc_vs_gt(const sp_msvc_vs_t* a, const sp_msvc_vs_t* b) {
+  if (sp_msvc_version_gt(a->version.build, b->version.build)) return true;
+  if (sp_msvc_version_gt(b->version.build, a->version.build)) return false;
+  if (!sp_str_equal(sp_msvc_path_str(&a->install_path), sp_msvc_path_str(&b->install_path))) return false;
+  if (a->preferred != b->preferred) return a->preferred;
+  return sp_msvc_version_gt(a->version.tools, b->version.tools);
+}
+
+static void sp_msvc_add_vs(sp_msvc_t* msvc, const sp_msvc_vs_t* vs) {
+  u32 at = msvc->num_installations;
+  while (at && sp_msvc_vs_gt(vs, &msvc->installations[at - 1])) at--;
+  if (at >= SP_MSVC_MAX_VS) return;
+
+  u32 num = sp_min(msvc->num_installations, SP_MSVC_MAX_VS - 1);
+  sp_mem_move(&msvc->installations[at + 1], &msvc->installations[at], (num - at) * sizeof(sp_msvc_vs_t));
+  msvc->installations[at] = *vs;
+  msvc->num_installations = num + 1;
+}
+
+static bool sp_msvc_vs_has_file(const sp_msvc_vs_t* vs, sp_msvc_vs_path_id_t id, sp_str_t file) {
+  c8 buf [SP_PATH_MAX] = sp_zero;
+  sp_io_mem_writer_t io = sp_zero;
+  sp_io_mem_writer_from_buffer(&io, buf, sizeof(buf));
+  if (sp_msvc_vs_path_io(&io.base, vs, id)) return false;
+  if (sp_io_write_str(&io.base, file, SP_NULLPTR)) return false;
+  sp_sys_file_meta_t meta = sp_zero;
+  return !sp_fs_get_path_metadata(sp_io_mem_writer_as_str(&io), &meta);
+}
+
+static sp_str_t sp_msvc_read_tools_version(sp_str_t path, c8* buf, u64 len) {
+  sp_io_file_reader_t reader = sp_zero;
+  if (sp_io_file_reader_from_path(&reader, path)) return sp_zero_s(sp_str_t);
+
+  u64 num_read = 0;
+  sp_io_read_all(&reader.base, buf, len, &num_read);
+  sp_io_file_reader_close(&reader);
+  return sp_str_trim(sp_str(buf, sp_cast(u32, num_read)));
+}
+
+SP_PRIVATE void sp_msvc_scan_instance(sp_msvc_t* msvc, sp_msvc_arch_t host, sp_msvc_arch_t target, const sp_msvc_state_t* state) {
+  sp_str_t install = sp_msvc_path_str(&state->install_path);
+
+  c8 buf [SP_PATH_MAX] = sp_zero;
+  c8 tools_buf [64] = sp_zero;
+  sp_str_t preferred = sp_zero;
+  sp_str_r path = sp_fmt_buf(buf, sizeof(buf), "{}/VC/Auxiliary/Build/Microsoft.VCToolsVersion.default.txt", sp_fmt_str(install));
+  if (!path.err) preferred = sp_msvc_read_tools_version(path.value, tools_buf, sizeof(tools_buf));
+
+  path = sp_fmt_buf(buf, sizeof(buf), "{}/VC/Tools/MSVC", sp_fmt_str(install));
+  if (path.err) return;
+
+  sp_sys_dir_t dir = sp_zero;
+  if (sp_fs_open_dir_at(sp_path_from_str(path.value), &dir)) return;
+
+  sp_fs_dir_it_t iter = sp_fs_dir_it(dir);
+  SP_ALIGNED u8 dir_buf [SP_SYS_DIR_MIN_BUF];
+  sp_fs_dir_entry_t entry = sp_zero;
+  while (sp_fs_dir_it_next(&iter, sp_mem_slice(dir_buf, sizeof(dir_buf)), &entry)) {
+    if (entry.kind != SP_FS_KIND_DIR) continue;
+
+    sp_msvc_vs_t vs = sp_msvc_vs_new(host, target, state, entry.name);
+    if (!sp_msvc_vs_has_file(&vs, SP_MSVC_VS_PATH_LIB, sp_str_lit("/vcruntime.lib"))) continue;
+    vs.preferred = sp_str_equal(entry.name, preferred);
+    vs.compiler = sp_msvc_vs_has_file(&vs, SP_MSVC_VS_PATH_BIN, sp_str_lit("/cl.exe"));
+    sp_msvc_add_vs(msvc, &vs);
+  }
+  sp_fs_dir_it_close(&iter);
+  sp_fs_close_dir(dir);
+}
+
