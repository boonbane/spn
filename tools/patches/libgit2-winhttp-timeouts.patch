+static BOOL set_timeouts(HINTERNET handle)
+{
+	int connect_timeout = git_socket_stream__connect_timeout > 0 ?
+		git_socket_stream__connect_timeout : TIMEOUT_INFINITE;
+	int timeout = git_socket_stream__timeout > 0 ?
+		git_socket_stream__timeout : TIMEOUT_INFINITE;
+
+	return WinHttpSetTimeouts(handle, TIMEOUT_INFINITE, connect_timeout, timeout, timeout);
+}
