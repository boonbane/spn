+sp_err_t sp_ps_win32_append_batch_arg(sp_io_writer_t* builder, sp_str_t arg) {
+  bool needs_quotes = sp_str_empty(arg) || arg.data[arg.len - 1] == '\\';
+  sp_for(i, arg.len) {
+    c8 c = arg.data[i];
+    if (c == '\0' || c == '\r' || c == '\n') {
+      return SP_ERR_SYS_INVALID;
+    }
+
+    bool plain = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
+    if (!plain && sp_str_find_c8(sp_str_lit("#$*+-./:?@\\_"), c) == SP_STR_NO_MATCH) {
+      needs_quotes = true;
+    }
+  }
+
+  if (needs_quotes) {
+    sp_io_write_c8(builder, '"');
+  }
+
+  u32 backslashes = 0;
+  sp_for(i, arg.len) {
+    c8 c = arg.data[i];
+    if (c == '\\') {
+      backslashes++;
+    }
+    else {
+      if (c == '"') {
+        sp_for(j, backslashes) {
+          sp_io_write_c8(builder, '\\');
+        }
+        sp_io_write_c8(builder, '"');
+      }
+      else if (c == '%') {
+        sp_io_write_cstr(builder, "%%cd:~,", SP_NULLPTR);
+      }
+      backslashes = 0;
+    }
+    sp_io_write_c8(builder, c);
+  }
+
+  if (needs_quotes) {
+    sp_for(i, backslashes) {
+      sp_io_write_c8(builder, '\\');
+    }
+    sp_io_write_c8(builder, '"');
+  }
+
+  return SP_OK;
+}
+
+sp_err_t sp_ps_build_windows_batch_cmdline(sp_mem_t mem, sp_str_t script, sp_ps_config_t* config, c8** cmdline) {
+  sp_io_dyn_mem_writer_t builder = sp_zero;
+  sp_io_dyn_mem_writer_init(mem, &builder);
+
+  sp_io_write_cstr(&builder.base, "cmd.exe /d /e:ON /v:OFF /c \"\"", SP_NULLPTR);
+  sp_io_write_str(&builder.base, script, SP_NULLPTR);
+  sp_io_write_c8(&builder.base, '"');
+
+  sp_carr_for(config->args, it) {
+    sp_str_t arg = config->args[it];
+    if (sp_str_empty(arg)) {
+      break;
+    }
+
+    sp_io_write_c8(&builder.base, ' ');
+    sp_try(sp_ps_win32_append_batch_arg(&builder.base, arg));
+  }
+
+  sp_da_for(config->dyn_args, it) {
+    sp_io_write_c8(&builder.base, ' ');
+    sp_try(sp_ps_win32_append_batch_arg(&builder.base, config->dyn_args[it]));
+  }
+
+  sp_io_write_c8(&builder.base, '"');
+  sp_io_write_c8(&builder.base, '\0');
+  *cmdline = (c8*)sp_io_dyn_mem_writer_as_str(&builder).data;
+  return SP_OK;
+}
+
+sp_err_t sp_ps_win32_build_command(sp_mem_t mem, sp_ps_config_t* config, c8** application, c8** cmdline) {
+  c8 script [SP_PATH_MAX] = sp_zero;
+  u32 len = GetFullPathNameA(sp_str_to_cstr(mem, config->command), SP_PATH_MAX, script, SP_NULLPTR);
+  if (!len) return sp_sys_err_from_win32(GetLastError());
+  if (len >= SP_PATH_MAX) return SP_ERR_SYS_NAME_TOO_LONG;
+
+  sp_str_t path = sp_str(script, len);
+  sp_str_t ext = sp_str_to_lower(mem, sp_str_suffix(path, (s32)sp_min(len, 4)));
+  if (!sp_str_equal(ext, sp_str_lit(".bat")) && !sp_str_equal(ext, sp_str_lit(".cmd"))) {
+    *cmdline = sp_ps_build_windows_cmdline(mem, config);
+    return SP_OK;
+  }
+
+  if (sp_fs_get_name(config->command).len == config->command.len) return SP_ERR_SYS_UNSUPPORTED;
+  if (GetFileAttributesA(script) == INVALID_FILE_ATTRIBUTES) return sp_sys_err_from_win32(GetLastError());
+
+  c8 system [SP_PATH_MAX] = sp_zero;
+  u32 system_len = GetSystemDirectoryA(system, SP_PATH_MAX);
+  *application = sp_str_to_cstr(mem, sp_fmt(mem, "{}\\cmd.exe", sp_fmt_str(sp_str(system, system_len))).value);
+  return sp_ps_build_windows_batch_cmdline(mem, path, config, cmdline);
+}
