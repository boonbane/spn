        "name": { "type": "string" },
        "requested": { "type": "string" },
        "requester": { "ref": "linkage_requester" },
        "consumer": { "type": "string" },
        "supported": { "elements": { "metadata": { "extern": "linkage" } } }
      }
    },
    "script": {
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "code": { "type": "int32" }
      }
    },
    "option_setter_kind": { "enum": ["none", "default", "profile", "root_manifest", "union", "consumer"] },
    "setter": {
      "properties": {
        "kind": { "ref": "option_setter_kind" }
      },
      "optionalProperties": {
        "name": { "type": "string" }
