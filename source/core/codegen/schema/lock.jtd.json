{
  "metadata": { "format": "toml" },
  "properties": {
    "version": { "type": "uint64" }
  },
  "optionalProperties": {
    "index": { "elements": { "ref": "lock_index" } },
    "package": { "elements": { "ref": "lock_package" } }
  },
  "definitions": {
    "lock_index": {
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "rev": { "type": "string" }
      }
    },

    "lock_root": {
      "properties": {
        "url": { "type": "string" },
        "rev": { "type": "string" }
      },
      "optionalProperties": {
        "dir": { "type": "string" }
      }
    },

    "lock_package": {
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      },
      "optionalProperties": {
        "source": { "ref": "lock_root" },
        "manifest": { "ref": "lock_root" }
      }
    }
  }
}
