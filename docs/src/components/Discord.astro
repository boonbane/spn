---
import { links } from '@spn/docs/data/links'

interface Props {
  invite: keyof typeof links.discord
}

const copy: Record<Props['invite'], { title: string; description: string }> = {
  public: { title: 'spn on Discord', description: 'questions, bug reports, and chat' },
  beta: { title: 'spn beta on Discord', description: 'private channel for beta testers' },
}

const { invite } = Astro.props
const { title, description } = copy[invite]
---

<a class="discord" href={links.discord[invite]} target="_blank" rel="noopener" data-invite={invite}>
  <svg viewBox="0 0 127.14 96.36" aria-hidden="true"><path d="M81.15,0c-1.2376,2.1973-2.3489,4.4704-3.3591,6.794-9.5975-1.4396-19.3718-1.4396-28.9945,0-.985-2.3236-2.1216-4.5967-3.3591-6.794-9.0166,1.5407-17.8059,4.2431-26.1405,8.0568C2.779,32.5304-1.6914,56.3725.5312,79.8863c9.6732,7.1476,20.5083,12.603,32.0505,16.0884,2.6014-3.4854,4.8998-7.1981,6.8698-11.0623-3.738-1.3891-7.3497-3.1318-10.8098-5.1523.9092-.6567,1.7932-1.3386,2.6519-1.9953,20.281,9.547,43.7696,9.547,64.0758,0,.8587.7072,1.7427,1.3891,2.6519,1.9953-3.4601,2.0457-7.0718,3.7632-10.835,5.1776,1.97,3.8642,4.2683,7.5769,6.8698,11.0623,11.5419-3.4854,22.3769-8.9156,32.0509-16.0631,2.626-27.2771-4.496-50.9172-18.817-71.8548C98.9811,4.2684,90.1918,1.5659,81.1752.0505l-.0252-.0505ZM42.2802,65.4144c-6.2383,0-11.4159-5.6575-11.4159-12.6535s4.9755-12.6788,11.3907-12.6788,11.5169,5.708,11.4159,12.6788c-.101,6.9708-5.026,12.6535-11.3907,12.6535ZM84.3576,65.4144c-6.2637,0-11.3907-5.6575-11.3907-12.6535s4.9755-12.6788,11.3907-12.6788,11.4917,5.708,11.3906,12.6788c-.101,6.9708-5.026,12.6535-11.3906,12.6535Z" /></svg>
  <span class="text">
    <span class="title">{title}</span>
    <span class="description">{description}</span>
  </span>
  <span class="join">join →</span>
</a>

<script>
  import { send } from '@spn/docs/lib/events'

  document.addEventListener('click', (event) => {
    const card = (event.target as Element).closest<HTMLElement>('.discord')
    if (card) send('discord', card.dataset.invite)
  })
</script>

<style>
  .discord {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-5);
    padding: var(--s-4) var(--s-5);
    background: var(--bg-inset);
    border: var(--border-strong);
    border-radius: var(--r-lg);

    &:hover {
      border-color: var(--line-hover);
    }

    &:hover .join {
      color: var(--accent-hover);
    }

    @media (max-width: 480px) {
      padding: var(--s-4);
    }
  }

  svg {
    width: 28px;
    overflow: visible;
    fill: var(--text-dim);
  }

  .text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .title {
    font-size: var(--text-md);
  }

  .description {
    font-size: var(--text-sm);
    color: var(--text-mute);
  }

  .join {
    color: var(--accent-bright);
    font-size: var(--text-sm);
    white-space: nowrap;
  }
</style>
