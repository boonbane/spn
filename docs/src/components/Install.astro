---
import Tabs from '@spn/docs/components/Tabs.astro'
import { targets } from '@spn/docs/data/install'
---

<Tabs group="install" tabs={targets}>
  <figure class="code-block install">
    {targets.map((target, i) => <pre role="tabpanel" data-tab={target.id} data-prompt={target.prompt} hidden={i !== 0} set:html={target.command.replaceAll('/', '/<wbr>')} />)}
    <button class="code-copy" type="button" aria-label="copy" title="copy"></button>
  </figure>
</Tabs>

<script>
  import { send } from '@spn/docs/lib/events'

  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLElement>('.install .code-copy')
    if (!button) return
    const pre = button.parentElement!.querySelector<HTMLElement>(':scope > pre:not([hidden])')!
    send('copy', pre.dataset.tab)
  })
</script>

<style>
  :global([data-tabs='install']) {
    --tab-bg: var(--bg-inset);
  }

  .install {
    --code-bg: var(--bg-inset);

    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-5);
    padding: var(--s-4) var(--s-5);
    font-size: var(--text-md);

    @media (max-width: 480px) {
      padding: var(--s-4);
      font-size: var(--text-sm);
    }
  }

  .install pre {
    grid-area: 1 / 1;
    padding: 0;
    font: inherit;
    font-family: var(--font-mono);
    white-space: normal;

    &[hidden] {
      display: block;
      visibility: hidden;
    }

    &::before {
      content: attr(data-prompt) ' ';
      color: var(--accent);
    }
  }
</style>
