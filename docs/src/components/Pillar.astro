---
import { Code } from 'astro:components'
import type { BuiltinLanguage } from 'shiki'
import { codeBlock } from '@spn/docs/lib/code'
import { theme } from '@spn/docs/lib/theme'

interface Props {
  title: string
  head: string
  code: string
}

const DIR = '/content/landing/pillars'
const files = import.meta.glob<string>(['/content/landing/pillars/*', '!/content/landing/pillars/*.md'], { query: '?raw', import: 'default', eager: true })

const { title, head, code } = Astro.props
const source = files[`${DIR}/${code}`]
if (source === undefined) throw new Error(`pillar code ${code} missing from ${DIR}`)
const lang = code.split('.').pop() as BuiltinLanguage
---

<section class="pillar">
  <div>
    <h2>{title}</h2>
    <div class="prose"><slot /></div>
  </div>
  <div class="code">
    <div class="code-head">{head}</div>
    <Code code={source.trimEnd()} lang={lang} theme={theme} transformers={[codeBlock]} />
  </div>
</section>

<style>
  .pillar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-10);
    align-items: center;

    @media (max-width: 56.25rem) {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-8);
    }
  }

  .prose {
    font-size: var(--text-md);
    color: var(--text-dim);
  }

  .prose :global(p) {
    margin-block: var(--s-4) 0;
  }

  .code {
    overflow: hidden;
    background: var(--code-bg);
    border: var(--border-strong);
    border-radius: var(--r-lg);
  }

  .code :global(.code-block) {
    border: none;
    border-radius: 0;
  }

  .code :global(.code-block + .code-block pre) {
    padding-top: 0;
  }
</style>
