---
import { getCollection, render } from 'astro:content'
import Nav from '@spn/docs/components/Nav.astro'
import Shell from '@spn/docs/layouts/Shell.astro'
import { position } from '@spn/docs/lib/order'

export async function getStaticPaths() {
  const docs = (await getCollection('docs', (doc) => doc.data.site)).sort((a, b) => position(a.id) - position(b.id))
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc, docs } }))
}

const { doc, docs } = Astro.props
const { Content } = await render(doc)

const groups = Map.groupBy(docs, (doc) => doc.data.group)
const outline = async (entry: typeof doc) => (await render(entry)).headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
const outlines = new Map(await Promise.all(docs.map(async (entry) => [entry.id, await outline(entry)] as const)))
---

<Shell title={`${doc.data.title} · spn`}>
  <div class="page">
    <header class="topbar"><Nav /></header>
    <div class="layout">
      <nav class="sidebar">
        {[...groups].map(([group, docs]) => (
          <section>
            <div class="label">{group}</div>
            <ul>
              {docs.map((entry) => (
                <li>
                  <a href={`/docs/${entry.id}`} aria-current={entry.id === doc.id ? 'page' : undefined}>{entry.data.title}</a>
                  <div class:list={['fold', { open: entry.id === doc.id }]}>
                    <ul class="outline">
                      {outlines.get(entry.id)!.map((heading) => (
                        <li class={`depth-${heading.depth}`}><a href={`/docs/${entry.id}#${heading.slug}`}>{heading.text}</a></li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </nav>
      <script is:inline>
        // Arriving from another doc, start with its outline open and ours shut, then let the fold play.
        {
          const from = document.referrer ? new URL(document.referrer) : undefined
          const path = from?.origin === location.origin ? from.pathname.replace(/\/$/, '') : ''
          const prev = document.querySelector(`.sidebar a[href="${CSS.escape(path)}"]:not([aria-current]) + .fold`)
          const next = document.querySelector('.fold.open')
          const fresh = performance.getEntriesByType('navigation')[0]?.type === 'navigate'
          if (prev && next && fresh && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            const flip = () => [prev, next].forEach((fold) => fold.classList.toggle('open'))
            const hold = (value) => [prev, next].forEach((fold) => (fold.style.transition = value))
            hold('none')
            flip()
            requestAnimationFrame(() => requestAnimationFrame(() => (hold(''), flip())))
          }
        }
      </script>
      <main class="doc">
        <h1>{doc.data.title}</h1>
        <article class="prose"><Content /></article>
      </main>
    </div>
  </div>
</Shell>

<style>
  .page {
    --topbar-h: 3.25rem;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: grid;
    align-items: center;
    height: var(--topbar-h);
    padding-inline: var(--s-7);
    background: var(--bg);
  }

  .layout {
    display: grid;
    grid-template-columns: 12rem minmax(0, 44rem);
    justify-content: center;
    gap: var(--s-9);
    padding-inline: var(--s-7);

    @media (max-width: 48rem) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .sidebar {
    position: sticky;
    top: var(--topbar-h);
    align-self: start;
    max-height: calc(100vh - var(--topbar-h));
    overflow-y: auto;
    padding-block: var(--s-7);
    font-size: var(--text-sm);

    @media (max-width: 48rem) {
      display: none;
    }

    section + section {
      margin-top: var(--s-6);
    }

    a {
      display: block;
      padding-block: var(--s-1);
      color: var(--text-dim);

      &:hover {
        color: var(--text);
      }

      &[aria-current='page'] {
        color: var(--accent-bright);
      }
    }
  }

  .fold {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition) ease-out;
    transition-property: grid-template-rows, opacity, visibility;

    &.open {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
    }

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .outline {
    min-height: 0;
    overflow: hidden;
    padding-left: var(--s-4);
    font-size: var(--text-xs);

    a {
      padding-block: var(--s-0);
      color: var(--text-mute);

      &:focus-visible {
        outline-offset: -2px;
      }
    }

    .depth-3 {
      padding-left: var(--s-4);
    }
  }

  .label {
    margin-bottom: var(--s-3);
    font-size: var(--text-md);
  }

  .doc {
    min-width: 0;
    padding-block: var(--s-9) var(--s-12);

    h1 {
      margin-bottom: var(--s-8);
      font-size: var(--text-3xl);
      font-weight: inherit;
      line-height: var(--leading-tight);
      letter-spacing: var(--tracking-tight);
    }
  }

  .doc :global(:is(h2, h3)) {
    scroll-margin-top: calc(var(--topbar-h) + var(--s-5));
  }
</style>
